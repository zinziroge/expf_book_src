/* 第6章: 分割数 N をいくつにすると、何次の多項式が要るのかを調べる。
 *
 * expf は 2^(r/N) を多項式で近似する（|r| <= 1/2）。
 * u = r/N とおくと、近似する区間は [-1/(2N), 1/(2N)] になる。
 * N を大きくすれば区間は狭まり必要な次数は下がるが、テーブルは大きくなる。
 *
 * 目標精度は glibc のコメントにある「相対誤差 1.69 * 2^-34」に合わせる。
 *
 * 実行: sollya n_tradeoff.sollya
 */

prec = 200!;
display = decimal!;

target = 1.69 * 2^(-34);

write("目標の相対誤差: ", target, "\n\n");
write("    N |  区間 [-1/(2N), 1/(2N)] |  必要な次数 |  テーブル(byte)\n");
write("------+-------------------------+-------------+----------------\n");

for i from 0 to 8 do {
    Nv = 2^i;
    half = 1/(2*Nv);
    I = [-half; half];
    d = guessdegree(2^x, I, target);
    write("  ", Nv, " | +-", half, " | ", d, " | ", Nv*8, "\n");
};

quit;
