// 1. 近似したいターゲット関数
f = log(1 + x);

// 2. 近似する区間 (一般的に logf(1+x) では [ -0.3, 0.4 ] や [ -0.5, 0.5 ] などの範囲が使われます)
// ここでは先ほどの係数に最も近づく一般的な範囲として、例として以下を設定します
I = [-0.35, 0.45];

// 3. 近似多項式の次数（x, x^2, x^3, x^4 の4項を指定。定数項 0 は含めない）
// これにより c1*x + c2*x^2 + c3*x^3 + c4*x^4 の形になります
powers = [|1, 2, 3, 4|];

// 4. 各係数の形式を double (倍精度) に指定
formats = [|double, double, double, double|];

// 5. fpminimax で最良の多項式を計算
p = fpminimax(f, powers, formats, I);

// 結果を表示
print("--- 算出された4次多項式 p(x) ---");
print(p);

print("\n--- 各係数の16進浮動小数点リテラル表示 ---");
display = hexadecimal;
print("c1 (x の係数)   :", coeff(p, 1));
print("c2 (x^2 の係数) :", coeff(p, 2));
print("c3 (x^3 の係数) :", coeff(p, 3));
print("c4 (x^4 の係数) :", coeff(p, 4));

display = decimal;
print("\n--- 各係数の10進数表示 ---");
print("c1 :", coeff(p, 1));
print("c2 :", coeff(p, 2));
print("c3 :", coeff(p, 3));
print("c4 :", coeff(p, 4));

// 最大絶対誤差の評価
error_poly = p - f;
max_err = dirtyinfnorm(error_poly, I);
print("\nこの区間における最大絶対誤差:", max_err);